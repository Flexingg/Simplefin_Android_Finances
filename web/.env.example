# Firebase configuration for the web/desktop app.
# Copy to .env and fill in for a real Firebase project, OR set VITE_USE_FIREBASE_EMULATOR=1
# and run `npx firebase-tools emulators:start` for local development (no project needed).
#
# Real values for project "jokarz-finance" are baked into src/firebase/config.ts as
# defaults, so the app works out of the box. Override here if you ever need to.

VITE_FIREBASE_API_KEY=AIzaSyCU_Ak-RIdUzJPkqWV37PXXT1ahXewa2JQ
VITE_FIREBASE_AUTH_DOMAIN=jokarz-finance.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jokarz-finance
VITE_FIREBASE_STORAGE_BUCKET=jokarz-finance.firebasestorage.app
VITE_FIREBASE_SENDER_ID=294176106740
VITE_FIREBASE_APP_ID=1:294176106740:web:b5d4e43f471404441fd6a1

# Set to 1 to use the local Firestore/Auth emulators instead of a real project.
VITE_USE_FIREBASE_EMULATOR=0
